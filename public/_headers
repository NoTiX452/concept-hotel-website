# Response headers for Cloudflare Workers static assets.
# Syntax and override behaviour: https://developers.cloudflare.com/workers/static-assets/headers/
# (read 2026-11-22). Rules here replace Cloudflare's default
# "Cache-Control: public, max-age=0, must-revalidate".

# Astro puts a content hash in every file name under /_astro/ (images, CSS,
# fonts, scripts). A changed file gets a new name, so browsers may keep these
# for a year without asking again. Pages (HTML) keep the default, so a new
# deploy shows up at once.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
