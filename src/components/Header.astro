---
import { hotel, nav } from "../content/hotel";

const current = Astro.url.pathname;
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href="/" aria-current={current === "/" ? "page" : undefined}>
      <span class="brand-name">{hotel.shortName}</span>
      <span class="brand-sub">Mountain House</span>
    </a>
    <nav aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={current.startsWith(item.href) ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-rule);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem var(--space-4);
    padding-block: 0.85rem;
  }

  .brand {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    color: var(--color-ink);
    text-decoration: none;
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .brand-sub {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-moss);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: inline-block;
    padding-block: 0.7rem; /* 44 px touch target */
    color: var(--color-ink);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
  }

  nav a:hover,
  nav a[aria-current="page"] {
    text-decoration: underline;
    text-decoration-color: var(--color-raspberry);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.4em;
  }

  /* Phones: the four links sit on their own row under the name. */
  @media (max-width: 44rem) {
    nav {
      width: 100%;
    }

    ul {
      justify-content: space-between;
      gap: 0 var(--space-2);
    }
  }
</style>
