---
// A heading whose words rise into view one after another.
// Each word is wrapped twice: the outer box clips, the inner one moves.
// Screen readers read the text normally; the wrappers are plain spans.
import { parseWords } from "../lib/text";

interface Props {
  text: string;
  as?: "h1" | "h2" | "h3" | "p";
  class?: string;
  id?: string;
  // Delay before the first word, in milliseconds.
  delay?: number;
}

const { text, as: Tag = "h2", class: className, id, delay = 0 } = Astro.props;
const words = parseWords(text);
---

<Tag class:list={["split", className]} id={id} data-reveal="words" style={`--delay: ${delay}ms`}>
  {
    words.map((word, i) => (
      <>
        <span class="w">
          {word.italic ? (
            <em class="w-in" style={`--i: ${i}`}>
              {word.text}
            </em>
          ) : (
            <span class="w-in" style={`--i: ${i}`}>
              {word.text}
            </span>
          )}
        </span>{" "}
      </>
    ))
  }
</Tag>
