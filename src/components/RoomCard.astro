---
import Photo from "./Photo.astro";
import type { Room } from "../content/hotel";

interface Props {
  room: Room;
}

const { room } = Astro.props;
---

<article class="room-card">
  <a class="room-link" href={`/rooms/${room.slug}/`}>
    <Photo name={room.photo} ratio="4 / 3" sizes="(min-width: 40rem) 50vw, 100vw" />
    <h3>{room.name}</h3>
  </a>
  <p class="summary">{room.summary}</p>
  <p class="facts">
    {room.sizeM2} m² · up to {room.guests} guests · from {room.priceFrom} lei a night
  </p>
</article>

<style>
  .room-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .room-link :global(img) {
    transition: transform 600ms var(--ease);
  }

  .room-link:hover :global(img) {
    transform: scale(1.03);
  }

  h3 {
    margin: var(--space-2) 0 var(--space-1);
  }

  .room-link:hover h3 {
    text-decoration: underline;
    text-decoration-color: var(--color-raspberry);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
  }

  .summary {
    margin-bottom: var(--space-1);
  }

  .facts {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-moss);
  }
</style>
