---
// A photo from the slot list (src/content/photos.ts).
// Production build: every photo must have a file and alt text, or the build stops.
// `astro dev`: a slot without a file shows as a labelled pending box.
//
// Presentation options:
// - ratio: the frame's aspect ratio; the photo is cropped to fill it.
// - fill: the frame takes its parent's height instead of a ratio.
// - reveal="mask": the frame opens upward when it scrolls into view.
// - parallax: the photo drifts inside its frame (0.08 = 8% of the scroll).
// - transitionName: a view-transition-name, so the photo can carry over
//   to the next page (a room card growing into the room page).
import { Picture } from "astro:assets";
import { resolvePhoto } from "../lib/photos";
import type { PhotoName } from "../content/photos";

interface Props {
  name: PhotoName;
  sizes: string;
  widths?: number[];
  class?: string;
  eager?: boolean;
  ratio?: string;
  fill?: boolean;
  reveal?: "mask";
  delay?: number;
  parallax?: number;
  transitionName?: string;
  // Override the slot's focus point (CSS object-position) for this frame.
  focus?: string;
}

const {
  name,
  sizes,
  widths = [480, 800, 1200, 1600],
  class: className,
  eager = false,
  ratio = "3 / 2",
  fill = false,
  reveal,
  delay = 0,
  parallax,
  transitionName,
  focus,
} = Astro.props;
const photo = resolvePhoto(name);
// Encoder quality for every photo (Astro accepts a preset or 0-100).
// Measured on this site's photos (all AVIF files together):
// default = "mid" = 50: 6.4 MB · 40: 4.0 MB · 35: 3.2 MB · "low": 2.0 MB.
// "low" visibly smears grass and wood grain at full size; 35 is close to 50;
// 40 keeps a margin. Re-measure if the photos change.
const QUALITY = 40;

if (!photo.ready && import.meta.env.PROD) {
  throw new Error(
    `Photo "${name}" is not ready (missing: ${photo.missing.join(", ")}). Add it to src/assets/photos/ and fill in src/content/photos.ts.`,
  );
}

const image = photo.image;
// Never ask for a size larger than the original file.
const usableWidths = image ? widths.filter((w) => w <= image.width) : [];
if (image && usableWidths.length === 0) usableWidths.push(image.width);

const style = [
  `--ratio: ${fill ? "auto" : ratio}`,
  `--focus: ${focus ?? photo.slot.focus ?? "center"}`,
  reveal ? `--delay: ${delay}ms` : "",
  transitionName ? `view-transition-name: ${transitionName}` : "",
]
  .filter(Boolean)
  .join("; ");
---

<div
  class:list={["photo", className, { "is-fill": fill, "has-parallax": parallax }]}
  style={style}
  data-reveal={reveal}
>
  <div class="photo-inner" data-parallax={parallax}>
    {
      image ? (
        <Picture
          src={image}
          formats={["avif", "webp"]}
          quality={QUALITY}
          widths={usableWidths}
          sizes={sizes}
          alt={photo.slot.alt}
          loading={eager ? "eager" : "lazy"}
          fetchpriority={eager ? "high" : "auto"}
          decoding={eager ? "sync" : "async"}
        />
      ) : (
        <div class="pending" role="img" aria-label={`Photo pending: ${photo.slot.subject}`}>
          <span class="pending-tag">Photo pending · {name}</span>
          <span class="pending-subject">{photo.slot.subject}</span>
        </div>
      )
    }
  </div>
  {image && !photo.ready && <span class="pending-badge">Dev only · {photo.missing.join(", ")} pending</span>}
</div>

<style>
  .photo {
    position: relative;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    background: color-mix(in srgb, var(--moss) 35%, var(--pine));
  }

  .photo.is-fill {
    height: 100%;
  }

  .photo-inner {
    position: absolute;
    inset: 0;
  }

  /* Parallax photos are taller than their frame, so the drift never shows an edge. */
  .has-parallax .photo-inner {
    inset: -12% 0;
  }

  .photo :global(picture),
  .photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .photo :global(img) {
    object-fit: cover;
    object-position: var(--focus);
  }

  /* Development only: production builds stop instead of showing these. */
  .pending {
    display: grid;
    align-content: center;
    gap: 0.5rem;
    height: 100%;
    padding: 1.5rem;
    border: 2px dashed var(--raspberry);
    background: var(--paper);
    color: var(--pine);
    font-family: var(--font-body);
  }

  .pending-tag {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--raspberry);
  }

  .pending-subject {
    max-width: 40ch;
    font-size: 0.95rem;
  }

  .pending-badge {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    padding: 0.2rem 0.5rem;
    background: var(--raspberry);
    color: var(--paper);
    font-size: 0.75rem;
    font-weight: 600;
  }
</style>
