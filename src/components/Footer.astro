---
import { hotel, conceptNotice, nav } from "../content/hotel";
import Ridge from "./Ridge.astro";
---

<footer class="site-footer tone-night">
  <div class="container">
    <div class="top">
      <p class="statement closing" data-reveal>{hotel.tagline}</p>
      <nav class="links" aria-label="Footer">
        <ul>
          {
            nav.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
          <li><a href="/credits/">About the photos</a></li>
          <li><a href={hotel.repo}>Source code on GitHub</a></li>
        </ul>
      </nav>
    </div>

    <Ridge class="footer-ridge" />

    <p class="wordmark" aria-hidden="true">{hotel.shortName}</p>

    <div class="bottom">
      <div class="notice">
        <p class="notice-title"><span class="berry" aria-hidden="true"></span> About this site</p>
        <p>{conceptNotice.long}</p>
      </div>
      <p class="meta">
        {hotel.region}<br />
        Concept by {hotel.author}
      </p>
      <a class="to-top" href="#main">Back to top <span aria-hidden="true">↑</span></a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--section) var(--space-4);
    overflow: hidden;
  }

  .top {
    display: grid;
    gap: var(--space-6);
    align-items: end;
  }

  @media (min-width: 60rem) {
    .top {
      grid-template-columns: 1.6fr 1fr;
    }
  }

  .closing {
    max-width: 18ch;
    margin: 0;
  }

  .links ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .links a {
    display: inline-block;
    padding-block: 0.6rem;
    color: var(--cream);
    font-size: var(--text-sm);
    text-decoration: none;
    background: linear-gradient(currentColor, currentColor) left 85% / 0 1px no-repeat;
    transition: background-size 500ms var(--ease-out);
  }

  .links a:hover,
  .links a:focus-visible {
    background-size: 100% 1px;
  }

  .site-footer :global(.footer-ridge) {
    margin-top: var(--space-12);
    color: var(--moss);
  }

  .wordmark {
    margin: -0.08em 0 0;
    font-family: var(--font-display);
    font-size: clamp(5rem, 24vw, 26rem);
    font-weight: 250;
    line-height: 0.8;
    letter-spacing: -0.055em;
    text-align: center;
    color: var(--forest);
    user-select: none;
  }

  .bottom {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--rule);
    font-size: var(--text-sm);
    color: var(--lichen);
  }

  @media (min-width: 52rem) {
    .bottom {
      grid-template-columns: 2fr 1fr auto;
      align-items: start;
    }
  }

  .notice {
    max-width: 58ch;
  }

  .notice-title {
    margin-bottom: 0.4rem;
    font-weight: 600;
    color: var(--cream);
  }

  .meta {
    margin: 0;
  }

  .to-top {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    color: var(--cream);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: var(--text-xs);
    text-decoration: none;
  }

  .to-top:hover span {
    transform: translateY(-3px);
  }

  .to-top span {
    transition: transform 400ms var(--ease-out);
  }
</style>
