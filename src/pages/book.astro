---
// Request a stay: three short chapters, like a letter to reception.
// 01 the dates, 02 a room (the same photos as the room pages, with what is
// free and the sample price for the whole stay), 03 the guest's details.
// The request goes to /api/*, which worker/index.ts passes to the concept
// booking app, and arrives at its reception as pending.
// Room pages link here with ?room=<type> to preselect that room.
import BaseLayout from "../layouts/BaseLayout.astro";
import PageIntro from "../components/PageIntro.astro";
import Photo from "../components/Photo.astro";
import { bookingApp, requestStay as copy, rooms } from "../content/hotel";

const { when, room: where, who } = copy.steps;
---

<BaseLayout
  title="Request a stay"
  description="Choose dates and a room at Zmeuriș Mountain House and send the request to its reception."
>
  <PageIntro eyebrow="Request a stay" heading={copy.heading} lede={copy.intro} />

  <div class="book container" data-reception={bookingApp.url}>
    <p class="no-script">{copy.noScript} <a href="/rooms/">See the rooms</a></p>

    <form class="chapter search" data-search novalidate aria-labelledby="when-title">
      <div class="chapter-head">
        <span class="eyebrow"><span class="num">01</span>{when.label}</span>
        <h2 id="when-title">{when.title}</h2>
      </div>
      <div class="chapter-body">
        <div class="error-summary" data-error-summary tabindex="-1" hidden></div>
        <div class="fields dates">
          <div class="field">
            <label for="checkIn">Arrival</label>
            <input id="checkIn" name="checkIn" type="date" required aria-describedby="checkIn-error" />
            <p class="error" id="checkIn-error" data-error-for="checkIn"></p>
          </div>
          <div class="field">
            <label for="checkOut">Departure</label>
            <input id="checkOut" name="checkOut" type="date" required aria-describedby="checkOut-error" />
            <p class="error" id="checkOut-error" data-error-for="checkOut"></p>
          </div>
          <div class="field">
            <label for="guests">Guests</label>
            <select id="guests" name="guests" aria-describedby="guests-error">
              <option value="1">1 guest</option>
              <option value="2" selected>2 guests</option>
              <option value="3">3 guests</option>
              <option value="4">4 guests</option>
            </select>
            <p class="error" id="guests-error" data-error-for="guests"></p>
          </div>
        </div>
        <div class="actions">
          <button class="button solid" type="submit"><span data-label>Show free rooms</span></button>
          <p class="hint">{copy.stayHint}</p>
        </div>
      </div>
    </form>

    <form class="results" data-book novalidate hidden aria-label="Room and details">
      <section class="chapter" aria-labelledby="room-title">
        <div class="chapter-head">
          <span class="eyebrow"><span class="num">02</span>{where.label}</span>
          <h2 id="room-title" tabindex="-1">{where.title}</h2>
          <p class="stay-line" data-stay-summary></p>
        </div>
        <div class="chapter-body">
          <fieldset aria-describedby="roomType-error">
            <legend class="visually-hidden">Room</legend>
            <ul class="choices">
              {
                rooms.map((room) => {
                  const id = `room-${room.bookingType}`;
                  return (
                    <li class="choice">
                      <Photo
                        name={room.photo}
                        ratio="4 / 3"
                        sizes="(min-width: 90rem) 28rem, (min-width: 60rem) 30vw, (min-width: 36rem) 45vw, 100vw"
                        widths={[400, 640, 900]}
                      />
                      <div class="choice-text">
                        <input
                          type="radio"
                          name="roomType"
                          id={id}
                          value={room.bookingType}
                          aria-describedby={`${id}-meta ${id}-free`}
                        />
                        <label for={id}>{room.name}</label>
                        <span class="choice-meta" id={`${id}-meta`}>
                          {room.sizeM2} m² · sleeps up to {room.guests}
                          <span class="choice-price" data-price />
                        </span>
                        <span class="choice-free" id={`${id}-free`} data-free />
                      </div>
                    </li>
                  );
                })
              }
            </ul>
            <p class="error" id="roomType-error" data-error-for="roomType"></p>
          </fieldset>
          <p class="note" role="status" data-room-note></p>
        </div>
      </section>

      <section class="chapter" aria-labelledby="who-title">
        <div class="chapter-head">
          <span class="eyebrow"><span class="num">03</span>{who.label}</span>
          <h2 id="who-title">{who.title}</h2>
        </div>
        <div class="chapter-body">
          <div class="error-summary" data-error-summary tabindex="-1" hidden></div>
          <p class="privacy">{copy.privacy}</p>
          <!-- autocomplete="off": the demo asks for made-up details, so the
               browser should not offer to fill in the visitor's real ones. -->

          <div class="fields details">
            <div class="field">
              <label for="name">Name</label>
              <input id="name" name="name" type="text" autocomplete="off" required maxlength="100" aria-describedby="name-error" />
              <p class="error" id="name-error" data-error-for="name"></p>
            </div>
            <div class="field">
              <label for="email">Email</label>
              <input id="email" name="email" type="email" autocomplete="off" required maxlength="254" aria-describedby="email-error" />
              <p class="error" id="email-error" data-error-for="email"></p>
            </div>
            <div class="field wide">
              <label for="notes">Anything reception should know <span class="optional">(optional)</span></label>
              <textarea id="notes" name="notes" maxlength="500" rows="3" aria-describedby="notes-error"></textarea>
              <p class="error" id="notes-error" data-error-for="notes"></p>
            </div>
          </div>
          <p class="request-line" data-request-summary></p>
          <div class="actions">
            <button class="button solid" type="submit"><span data-label>Send the request</span></button>
            <p class="hint">{copy.priceHint}</p>
          </div>
          <p class="note" role="status" data-book-status></p>
        </div>
      </section>
    </form>

    <section class="done tone-pine" data-done hidden aria-labelledby="done-title">
      <span class="eyebrow"><span class="berry" aria-hidden="true"></span>{copy.done.label}</span>
      <h2 id="done-title" tabindex="-1">Your reference is <span class="reference" data-reference></span></h2>
      <dl class="done-summary" data-summary></dl>
      <p class="done-text">{copy.done.text}</p>
      <div class="done-links">
        <a class="button" href={`${bookingApp.url}/staff/login/`} data-reception-link>
          See it arrive at reception <span class="arrow" aria-hidden="true">→</span>
        </a>
        <a class="link-arrow" href="/book/">Request another stay <span class="line" aria-hidden="true"></span></a>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import "../scripts/book";
</script>

<style>
  .book {
    padding-bottom: var(--section);
  }

  /* Without JavaScript the rooms cannot be checked: say so, hide the forms. */
  .no-script {
    max-width: var(--measure);
    padding: var(--space-3);
    background: var(--paper);
  }

  :global(.js) .no-script,
  :global(html:not(.js)) .search {
    display: none;
  }

  /* ---------- Chapters ----------
   * Each step is a row: number and title on the left, the fields on the
   * right. On phones they stack. */
  .chapter {
    display: grid;
    gap: var(--space-3) var(--space-6);
    padding-block: var(--space-6) var(--space-8);
    border-top: 1px solid var(--rule);
  }

  @media (min-width: 60rem) {
    .chapter {
      grid-template-columns: minmax(14rem, 1fr) 3fr;
    }

    .chapter-head {
      position: sticky;
      top: calc(var(--header-h) + var(--space-3));
      align-self: start;
    }
  }

  .chapter-head h2 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-1);
  }

  .chapter-head h2:focus {
    outline: none;
  }

  .chapter-head .eyebrow {
    margin-bottom: var(--space-2);
  }

  .stay-line {
    max-width: 26ch;
    margin: 0;
    color: var(--fg-soft);
  }

  .chapter-body {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    min-width: 0;
  }

  /* The results rise into place when the dates are chosen. */
  @media (prefers-reduced-motion: no-preference) {
    .results:not([hidden]),
    .done:not([hidden]) {
      animation: rise 800ms var(--ease-out) both;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(1.5rem);
    }
  }

  /* ---------- Fields ---------- */
  fieldset {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .fields {
    display: grid;
    gap: var(--space-2) var(--space-3);
  }

  @media (min-width: 40rem) {
    .dates {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .details {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .details .wide {
      grid-column: 1 / -1;
    }
  }

  .field {
    display: grid;
    gap: 0.4rem;
    align-content: start;
    min-width: 0;
  }

  label {
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .optional {
    color: var(--fg-soft);
    font-weight: 400;
  }

  input:not([type="radio"]),
  select,
  textarea {
    width: 100%;
    min-height: 3.25rem;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--moss);
    border-radius: var(--radius);
    background: var(--paper);
    color: var(--pine);
    font: inherit;
    transition: border-color var(--dur-fast) var(--ease);
  }

  input:not([type="radio"]):hover,
  select:hover,
  textarea:hover {
    border-color: var(--pine);
  }

  textarea {
    min-height: 6.5rem;
    resize: vertical;
  }

  [aria-invalid="true"] {
    border-color: var(--error) !important;
    box-shadow: inset 4px 0 0 var(--error);
  }

  .error {
    margin: 0;
    color: var(--error);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .error:empty {
    display: none;
  }

  .hint {
    margin: 0;
    color: var(--fg-soft);
    font-size: var(--text-sm);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    align-items: center;
  }

  /* The site's pill button, filled: these are the page's two decisions. */
  button.button {
    background: none;
    font-family: inherit;
    cursor: pointer;
  }

  .button.solid {
    border-color: var(--fg);
    background: var(--fg);
    color: var(--bg);
  }

  .button.solid::before {
    background: var(--accent);
  }

  .button.solid:hover,
  .button.solid:focus-visible {
    border-color: var(--accent);
    color: var(--cream);
  }

  .button[aria-disabled="true"] {
    opacity: 0.7;
    cursor: progress;
  }

  /* After a failed send: the list of problems, focused so it is read out. */
  .error-summary {
    padding: var(--space-2) var(--space-3);
    border: 2px solid var(--error);
    background: var(--paper);
  }

  .error-summary :global(.summary-title) {
    margin: 0 0 0.25rem;
    font-weight: 700;
  }

  .error-summary :global(ul) {
    margin: 0;
    padding-left: 1.1rem;
  }

  .error-summary :global(a) {
    display: inline-block;
    padding-block: calc((2.75rem - 1lh) / 2);
    color: var(--error);
    font-weight: 600;
  }

  .note {
    margin: 0;
    padding: var(--space-2) var(--space-3);
    border-left: 3px solid var(--moss);
    background: var(--paper);
  }

  .note[data-tone="error"] {
    border-left-color: var(--error);
  }

  .note:empty {
    display: none;
  }

  .privacy {
    max-width: var(--measure);
    margin: 0;
    padding-left: var(--space-2);
    border-left: 3px solid var(--accent);
    color: var(--fg-soft);
    font-size: var(--text-sm);
  }

  .request-line {
    max-width: var(--measure);
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-style: italic;
    font-weight: 300;
    line-height: 1.4;
  }

  .request-line:empty {
    display: none;
  }

  /* ---------- Room choices ----------
   * The whole card is the radio's label: the label's ::after covers it. */
  .choices {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 36rem) {
    .choices {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .choice {
    position: relative;
    display: grid;
    align-content: start;
    background: var(--paper);
    outline: 1px solid transparent;
    transition: outline-color var(--dur-fast) var(--ease);
  }

  .choice :global(.photo img) {
    transition: transform var(--dur) var(--ease-out);
  }

  .choice:hover :global(.photo img) {
    transform: scale(1.03);
  }

  .choice-text {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.2rem 0.75rem;
    padding: var(--space-2) var(--space-3) var(--space-3);
  }

  .choice input {
    grid-row: 1;
    align-self: center;
    width: 1.2rem;
    height: 1.2rem;
    margin: 0;
    accent-color: var(--accent);
  }

  .choice label {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 330;
    line-height: 1.1;
    letter-spacing: -0.015em;
    cursor: pointer;
  }

  .choice label::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .choice-meta,
  .choice-free {
    grid-column: 2;
    font-size: var(--text-sm);
  }

  .choice-meta {
    color: var(--fg-soft);
  }

  .choice-price {
    display: block;
    color: var(--fg);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .choice-free {
    font-weight: 600;
  }

  .choice-free[data-full] {
    color: var(--error);
  }

  .choice:has(input:checked) {
    outline: 2px solid var(--fg);
  }

  .choice:has(input:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .choice:has(input:disabled) label {
    cursor: not-allowed;
  }

  .choice:has(input:disabled) :global(.photo) {
    opacity: 0.45;
  }

  .choice:has(input:disabled):hover :global(.photo img) {
    transform: none;
  }

  /* ---------- Request received ---------- */
  .done {
    margin-top: var(--space-6);
    padding: clamp(2rem, 5vw, 5rem);
  }

  .done h2 {
    max-width: 18ch;
    font-size: var(--text-2xl);
  }

  .done h2:focus {
    outline: none;
  }

  .reference {
    display: block;
    margin-top: 0.3em;
    color: var(--blush);
    font-style: italic;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
  }

  .done-summary {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.5rem var(--space-4);
    max-width: 36rem;
    margin: var(--space-4) 0;
    padding-block: var(--space-3);
    border-block: 1px solid var(--rule);
  }

  .done-summary :global(dt) {
    color: var(--fg-soft);
    font-size: var(--text-sm);
  }

  .done-summary :global(dd) {
    margin: 0;
  }

  .done-text {
    max-width: var(--measure);
    color: var(--fg-soft);
  }

  .done-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    align-items: center;
    margin-top: var(--space-4);
  }
</style>
