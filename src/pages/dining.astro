---
// Dining: the day at the table. A day line drawn from the real meal times,
// then breakfast in morning light, dinner in the evening dark, and the
// sample menu as a printed card.
import BaseLayout from "../layouts/BaseLayout.astro";
import Photo from "../components/Photo.astro";
import Split from "../components/Split.astro";
import { dining } from "../content/hotel";

// The day line runs from 06:00 to 22:00. Positions come from the meal times
// in content/hotel.ts, so the graphic cannot drift from the copy.
const DAY_START = 6;
const DAY_END = 22;
const toHours = (hhmm: string) => {
  const [h, m] = hhmm.split(":").map(Number);
  return h + m / 60;
};
const pos = (hours: number) => ((hours - DAY_START) / (DAY_END - DAY_START)) * 100;
const marks = dining.meals.map((meal) => {
  const times = meal.time.match(/\d{2}:\d{2}/g) ?? [];
  if (!times[0]) throw new Error(`Meal "${meal.name}" needs a time like 07:30, not "${meal.time}"`);
  const start = toHours(times[0]);
  const end = times[1] ? toHours(times[1]) : undefined;
  return { name: meal.name, label: meal.time, left: pos(start), width: end ? pos(end) - pos(start) : 0 };
});
const hours = Array.from({ length: DAY_END - DAY_START + 1 }, (_, i) => DAY_START + i);
const [breakfast, dinner] = dining.meals;
const roman = ["I", "II", "III", "IV", "V"];
---

<BaseLayout title="Dining" description={dining.intro}>
  <header class="intro container">
    <span class="eyebrow"><span class="num">III</span>The table</span>
    <Split as="h1" text={dining.heading} delay={100} />
    <p class="lede" data-reveal style="--delay: 350ms">{dining.intro}</p>

    <figure class="dayline" data-reveal style="--delay: 500ms">
      <figcaption class="visually-hidden">
        Meal times: {dining.meals.map((m) => `${m.name}, ${m.time}`).join("; ")}.
      </figcaption>
      <div class="track" aria-hidden="true">
        {hours.map((h) => <span class="tick" style={`left: ${pos(h)}%`} data-label={h % 3 === 0 ? String(h).padStart(2, "0") : undefined} />)}
        {
          marks.map((mark) => (
            <span
              class:list={["mark", { point: mark.width === 0 }]}
              style={`left: ${mark.left}%; width: ${mark.width}%`}
            >
              <span class="mark-label">
                {mark.name} <span>{mark.label}</span>
              </span>
            </span>
          ))
        }
      </div>
    </figure>
  </header>

  <!-- Morning: the photo wide, the text laid on a card over its corner. -->
  <section class="morning tone-paper section" aria-labelledby="breakfast-title">
    <div class="container morning-grid">
      <Photo
        name={breakfast.photo}
        ratio="3 / 2"
        sizes="(min-width: 60rem) 70vw, 100vw"
        widths={[640, 960, 1280, 1600, 1920]}
        reveal="mask"
        parallax={0.06}
        class="morning-photo"
      />
      <div class="card" data-reveal>
        <p class="time">{breakfast.time}</p>
        <h2 id="breakfast-title">{breakfast.name}</h2>
        <p>{breakfast.text}</p>
      </div>
    </div>
  </section>

  <!-- Evening: dark, the hour set large beside a tall photo. -->
  <section class="evening tone-forest section" aria-labelledby="dinner-title">
    <div class="container evening-grid">
      <div class="evening-text">
        <p class="big-time" aria-hidden="true" data-reveal>{dinner.time.slice(0, 5)}</p>
        <h2 id="dinner-title" data-reveal>
          {dinner.name} <span class="time">{dinner.time}</span>
        </h2>
        <p class="evening-p" data-reveal>{dinner.text}</p>
      </div>
      <Photo
        name={dinner.photo}
        ratio="4 / 5"
        sizes="(min-width: 60rem) 40vw, 100vw"
        widths={[480, 800, 1200]}
        reveal="mask"
        parallax={0.1}
        class="evening-photo"
      />
    </div>
  </section>

  <!-- The sample menu, printed on a card. -->
  <section class="menu tone-pine section" aria-labelledby="menu-title">
    <div class="container">
      <article class="menu-card" data-reveal>
        <p class="menu-kicker">Zmeuriș · {dinner.name}</p>
        <h2 id="menu-title">A sample menu <em>for {dining.sampleMenu.season.toLowerCase()}</em></h2>
        <ol class="courses">
          {
            dining.sampleMenu.courses.map((course, i) => (
              <li>
                <span class="course-num" aria-hidden="true">
                  {roman[i]}
                </span>
                <span>{course}</span>
              </li>
            ))
          }
        </ol>
        <p class="menu-note">The menu is part of the concept: an example of what one evening might bring.</p>
      </article>
      <p class="statement lunch" data-reveal>{dining.packedLunch}</p>
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    padding-block: clamp(3rem, 8vw, 7rem) var(--section);
  }

  .intro :global(h1) {
    max-width: 12ch;
    font-size: var(--text-hero);
    font-weight: 260;
    letter-spacing: -0.045em;
    line-height: 0.9;
  }

  .intro .lede {
    margin: var(--space-4) 0 0 auto;
    max-width: 40ch;
  }

  /* ---------- Day line ---------- */

  .dayline {
    margin: var(--space-12) 0 0;
  }

  .track {
    position: relative;
    height: 7rem;
    border-bottom: 1px solid var(--fg);
  }

  .tick {
    position: absolute;
    bottom: 0;
    width: 1px;
    height: 0.6rem;
    background: var(--fg);
  }

  .tick[data-label]::after {
    content: attr(data-label);
    position: absolute;
    top: 1rem;
    left: 50%;
    transform: translateX(-50%);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    color: var(--fg-soft);
  }

  .mark {
    position: absolute;
    bottom: 0;
    height: 3px;
    background: var(--accent);
    transform-origin: left;
  }

  .mark.point {
    width: 11px !important;
    height: 11px;
    margin-left: -5px;
    bottom: -5px;
    border-radius: 50%;
  }

  .mark-label {
    position: absolute;
    bottom: 1.25rem;
    left: 0;
    display: grid;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    white-space: nowrap;
  }

  .mark.point .mark-label {
    left: auto;
    right: 0;
    text-align: right;
  }

  /* Narrow screens: the dinner label steps up a row so the two never touch. */
  @media (max-width: 40rem) {
    .mark.point .mark-label {
      bottom: 4rem;
    }
  }

  .mark-label span {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--fg-soft);
  }

  @media (prefers-reduced-motion: no-preference) {
    .js .dayline .mark:not(.point) {
      transform: scaleX(0);
      transition: transform 1400ms var(--ease-in-out) 900ms;
    }

    .js .dayline.is-visible .mark {
      transform: none;
    }
  }

  /* ---------- Morning ---------- */

  .morning-grid {
    display: grid;
  }

  .time {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .card {
    position: relative;
    max-width: 32rem;
    margin: -3rem var(--space-2) 0;
    padding: var(--space-4);
    background: var(--cream);
  }

  .card p:last-child {
    margin: 0;
    color: var(--fg-soft);
  }

  @media (min-width: 60rem) {
    .morning-grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    .morning-grid :global(.morning-photo) {
      grid-column: 1 / 10;
      grid-row: 1;
    }

    .card {
      grid-column: 8 / 13;
      grid-row: 1;
      align-self: end;
      margin: 0 0 calc(-1 * var(--space-8));
      padding: var(--space-6);
    }
  }

  /* ---------- Evening ---------- */

  .evening-grid {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 60rem) {
    .evening-grid {
      grid-template-columns: 7fr 5fr;
      gap: var(--space-8);
      align-items: center;
    }
  }

  .big-time {
    margin: 0 0 var(--space-2);
    font-family: var(--font-display);
    font-size: clamp(5rem, 2rem + 14vw, 16rem);
    font-style: italic;
    font-weight: 200;
    letter-spacing: -0.055em;
    line-height: 0.85;
    color: var(--blush);
  }

  .evening h2 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem var(--space-2);
  }

  .evening h2 .time {
    margin: 0;
    font-family: var(--font-body);
    letter-spacing: 0.16em;
  }

  .evening-p {
    max-width: 40ch;
    font-size: var(--text-lg);
    color: var(--fg-soft);
  }

  /* ---------- Menu card ---------- */

  .menu-card {
    max-width: 40rem;
    margin-inline: auto;
    padding: clamp(2rem, 6vw, 4.5rem) clamp(1.5rem, 6vw, 4.5rem);
    background: var(--cream);
    color: var(--pine);
    text-align: center;
    box-shadow:
      inset 0 0 0 10px var(--cream),
      inset 0 0 0 11px color-mix(in srgb, var(--pine) 35%, transparent),
      0 40px 80px -40px rgb(0 0 0 / 0.6);
    --fg-soft: var(--moss-ink);
    --accent: var(--raspberry);
  }

  /* The card lies a little crooked, then straightens as it arrives. */
  @media (prefers-reduced-motion: no-preference) {
    .js .menu-card[data-reveal] {
      transform: translateY(3rem) rotate(-2.5deg);
    }

    .js .menu-card[data-reveal].is-visible {
      transform: rotate(-0.6deg);
    }
  }

  .menu-kicker {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--fg-soft);
  }

  .menu-card h2 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-6);
  }

  .courses {
    display: grid;
    gap: var(--space-4);
    margin: 0 0 var(--space-6);
    padding: 0;
    list-style: none;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 300;
    line-height: 1.25;
  }

  .courses li {
    display: grid;
    gap: 0.5rem;
    justify-items: center;
  }

  .course-num {
    font-size: var(--text-sm);
    font-style: italic;
    color: var(--accent);
  }

  .menu-note {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--fg-soft);
  }

  .lunch {
    max-width: 26ch;
    margin: var(--section) auto 0;
    text-align: center;
  }
</style>
