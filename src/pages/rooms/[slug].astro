---
// A room: split screen. The photo holds still on one side (it carries over
// from the rooms list as a view transition) while the details scroll past.
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Photo from "../../components/Photo.astro";
import Split from "../../components/Split.astro";
import PriceNote from "../../components/PriceNote.astro";
import { rooms } from "../../content/hotel";

export const getStaticPaths = (() =>
  rooms.map((room, index) => ({
    params: { slug: room.slug },
    props: {
      room,
      index,
      next: rooms[(index + 1) % rooms.length],
      // The rest, without this room or the next one (it has its own big link).
      others: rooms.filter((r) => r.slug !== room.slug && r.slug !== rooms[(index + 1) % rooms.length].slug),
    },
  }))) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { room, index, next, others } = Astro.props;

const facts = [
  { term: "Size", detail: `${room.sizeM2} m²` },
  { term: "Sleeps", detail: `Up to ${room.guests} guests` },
  { term: "Beds", detail: room.beds },
  { term: "View", detail: room.view },
  { term: "Rooms of this kind", detail: String(room.count) },
  { term: "From", detail: `${room.priceFrom} lei a night` },
];
const pad = (n: number) => String(n).padStart(2, "0");
---

<BaseLayout title={room.name} description={room.summary}>
  <article class="room">
    <div class="media">
      <Photo
        name={room.photo}
        fill
        eager
        sizes="(min-width: 60rem) 50vw, 100vw"
        widths={[640, 960, 1280, 1600, 2000]}
        transitionName={`room-${room.slug}`}
      />
    </div>

    <div class="content">
      <a class="back" href="/rooms/"><span aria-hidden="true">←</span> All rooms</a>

      <header class="head">
        <span class="eyebrow"><span class="num">{pad(index + 1)}</span>Room {pad(index + 1)} of {pad(rooms.length)}</span>
        <Split as="h1" text={room.name} delay={150} />
        <p class="lede" data-reveal style="--delay: 350ms">{room.summary}</p>
      </header>

      <div class="body">
        {room.description.map((paragraph) => <p data-reveal>{paragraph}</p>)}
      </div>

      <section class="features" aria-labelledby="features-title" data-reveal>
        <h2 id="features-title">In the room</h2>
        <ul>
          {room.features.map((feature) => <li>{feature}</li>)}
        </ul>
      </section>

      <section class="sheet" aria-labelledby="sheet-title" data-reveal>
        <h2 id="sheet-title" class="visually-hidden">Room facts</h2>
        <dl>
          {
            facts.map((fact) => (
              <div class="fact">
                <dt>{fact.term}</dt>
                <dd>{fact.detail}</dd>
              </div>
            ))
          }
        </dl>
        <PriceNote />
      </section>
    </div>
  </article>

  <nav class="next tone-pine" aria-label="More rooms">
    <a class="next-link container" href={`/rooms/${next.slug}/`}>
      <span class="next-label">Next room <span aria-hidden="true">→</span></span>
      <span class="next-name">{next.name}</span>
      <span class="next-meta">{next.summary}</span>
    </a>
    <ul class="others container">
      {
        others.map((other) => (
          <li>
            <a href={`/rooms/${other.slug}/`}>
              <span class="other-name">{other.name}</span>
              <span class="other-meta">
                {other.sizeM2} m² · up to {other.guests} guests · from {other.priceFrom} lei
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</BaseLayout>

<style>
  .room {
    display: grid;
  }

  .media {
    height: 72svh;
    min-height: 22rem;
  }

  .content {
    width: min(100% - 2 * var(--gutter), 40rem);
    margin-inline: auto;
    padding-block: var(--space-6) var(--section);
  }

  @media (min-width: 60rem) {
    .room {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }

    .media {
      position: sticky;
      top: var(--header-h);
      height: calc(100svh - var(--header-h));
      min-height: 32rem;
    }

    .content {
      width: auto;
      max-width: 44rem;
      margin: 0;
      padding: var(--space-8) clamp(2rem, 6vw, 7rem) var(--section);
    }
  }

  .back {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    min-height: 2.75rem;
    margin-bottom: var(--space-6);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .back span {
    transition: transform 400ms var(--ease-out);
  }

  .back:hover span {
    transform: translateX(-4px);
  }

  .head :global(h1) {
    font-size: clamp(3.25rem, 2rem + 5vw, 7.5rem);
    font-weight: 260;
    letter-spacing: -0.045em;
  }

  .head .lede {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: var(--text-xl);
    line-height: 1.3;
    color: var(--fg);
  }

  .body {
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--rule);
  }

  .body p {
    font-size: var(--text-lg);
    color: var(--fg-soft);
  }

  .features {
    margin-top: var(--space-8);
  }

  .features h2,
  .sheet h2 {
    font-size: var(--text-xs);
    font-family: var(--font-body);
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--fg-soft);
  }

  .features ul {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 30rem) {
    .features ul {
      grid-template-columns: 1fr 1fr;
      column-gap: var(--space-4);
    }
  }

  .features li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-block: 0.7rem;
    border-bottom: 1px solid var(--rule);
  }

  .features li::before {
    content: "";
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  .sheet {
    margin-top: var(--space-8);
    padding: var(--space-4);
    background: var(--paper);
  }

  dl {
    margin: 0 0 var(--space-3);
  }

  .fact {
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: var(--space-2);
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--rule);
  }

  .fact:last-child {
    border-bottom: 0;
  }

  dt {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--fg-soft);
  }

  dd {
    margin: 0;
  }

  @media (max-width: 26rem) {
    .fact {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
  }

  /* ---------- Next room ---------- */

  .next {
    padding-block: var(--section) var(--space-8);
  }

  .next-link {
    display: grid;
    gap: var(--space-2);
    padding-bottom: var(--space-8);
    text-decoration: none;
    color: var(--fg);
  }

  .next-label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .next-label span {
    display: inline-block;
    transition: transform 500ms var(--ease-out);
  }

  .next-name {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 1.8rem + 8vw, 11rem);
    font-weight: 250;
    letter-spacing: -0.05em;
    line-height: 0.9;
    transition:
      transform 800ms var(--ease-out),
      color 400ms var(--ease);
  }

  .next-meta {
    max-width: 40ch;
    color: var(--fg-soft);
  }

  .next-link:hover .next-name,
  .next-link:focus-visible .next-name {
    transform: translateX(1.5rem);
    color: var(--accent);
  }

  .next-link:hover .next-label span {
    transform: translateX(6px);
  }

  .others {
    display: grid;
    margin-block: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--rule);
  }

  @media (min-width: 48rem) {
    .others {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: var(--space-4);
    }
  }

  .others a {
    display: grid;
    gap: 0.25rem;
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--rule);
    color: var(--fg);
    text-decoration: none;
  }

  .other-name {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    transition: color 300ms var(--ease);
  }

  .others a:hover .other-name {
    color: var(--accent);
  }

  .other-meta {
    font-size: var(--text-sm);
    color: var(--fg-soft);
  }
</style>
