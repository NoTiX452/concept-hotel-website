---
import "@fontsource-variable/fraunces/opsz.css";
import "@fontsource-variable/fraunces/opsz-italic.css";
import "@fontsource-variable/instrument-sans/wght.css";
import displayFont from "@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url";
import bodyFont from "@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url";
import "../styles/global.css";
import { hotel, conceptNotice } from "../content/hotel";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  // Text colour of the header over the page's first screen (see Header.astro).
  headerTone?: "dark" | "light";
}

const { title, description = hotel.intro, noindex = false, headerTone = "dark" } = Astro.props;
const fullTitle = title ? `${title} · ${hotel.name} (concept)` : `${hotel.name} (concept project)`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={`${conceptNotice.short} ${description}`} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#14271f" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <p class="concept-bar">
      <strong>Concept project.</strong>
      <span>Zmeuriș is a made-up hotel by {hotel.author}. Nothing here can be booked.</span>
    </p>
    <Header tone={headerTone} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import "../scripts/reveal";
      import "../scripts/parallax";
    </script>
  </body>
</html>

<style>
  .concept-bar {
    position: relative;
    z-index: 60;
    margin: 0;
    padding: 0.5rem var(--gutter);
    background: var(--night);
    color: var(--lichen);
    font-size: var(--text-xs);
    letter-spacing: 0.02em;
    text-align: center;
    view-transition-name: concept-bar;
  }

  .concept-bar strong {
    margin-right: 0.35rem;
    font-weight: 600;
    color: var(--blush);
  }
</style>
