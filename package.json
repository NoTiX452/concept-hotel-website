{
  "name": "concept-hotel-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Concept project: the website of Zmeuriș Mountain House, a made-up hotel in the Apuseni Mountains",
  "scripts": {
    "dev": "astro dev",
    "dev:worker": "npm run build && wrangler dev --port 8788",
    "build": "astro build && node scripts/check-build.mjs",
    "preview": "astro preview",
    "check": "astro check && tsc -p worker",
    "test": "node --test test/",
    "deploy": "npm run build && wrangler deploy",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "astro": "^7.4.13",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261121.1",
    "wrangler": "^4.166.0"
  }
}
